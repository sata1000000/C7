    "misc_commands": {
      "note": "Reverse-engineered and unconfirmed. Recorded so the bytes survive, not because anything sends them.",
      "analog_calibration": {
        "cmd": 124,
        "description": "Analog calibration request."
      },
      "press_stop": {
        "cmd": 248,
        "description": "Presses the Stop key. The BPM display does not show LOCK."
      },
      "press_stop_variant": {
        "cmd": 252,
        "description": "A second byte that also presses Stop. The BPM display does not show LOCK."
      },
      "freeze_bpm_lock_a": {
        "cmd": 250,
        "description": "Freezes the device briefly. The BPM display shows LOCK."
      },
      "freeze_bpm_lock_b": {
        "cmd": 251,
        "description": "Freezes the device briefly. The BPM display shows LOCK."
      },
      "multi_block_dump": {
        "cmd": 253,
        "description": "Replies with a large multi-block dump in an unknown format. Takes one parameter byte."
      },
      "dump_stream": {
        "cmd": 96,
        "description": "Starts a continuous stream of dumps. Purpose unknown."
      },
      "track_pitch": {
        "cmd": 224,
        "stride": 1,
        "description": "One command byte per track counting up from 224, so track 1 is 224 and track 4 is 227. Shifts that track's pitch. 232 appears to be an alternate range for the same thing."
      }
    }
