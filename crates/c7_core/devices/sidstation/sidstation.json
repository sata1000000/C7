    240,
    0,
    32,
    60,
    1
  ],
  "system": {
    "panic_all_notes_off": {
      "cc": 123,
      "val": 0,
      "description": "All Notes Off."
    },
    "bank_select_reset": {
      "cc": 0,
      "val": 0,
      "description": "Sent alongside Panic to reset bank selects."
    },
    "piano_keyboard_input": true,
    "piano_keyboard_output": true,
    "pitch_bend_input": true
  },
  "sysex_api": {
    "librarian": false,
    "has_turbomidi": false,
    "commands": {
      "patch_all_clear": {
        "block_byte": "01",
        "description": "Wipes every patch slot."
      },
      "patch_dump": {
        "block_byte": "02",
        "description": "Carries one patch, in both directions. The size bytes hold the patch length in bytes, high bits first. Byte layout is in `sysex_layout.patch`."
      },
      "skip_patch": {
        "block_byte": "03",
        "description": "Steps the receiving patch position on by one without writing, leaving that slot as it was."
      },
      "direct_program": {
        "block_byte": "04",
        "description": "Writes one field of the patch currently being edited, addressed as a 10-bit memory position. The mask picks which bits of the target byte get replaced. The shift is how far up the data moves first."
      }
    },
    "patch": {
      "write_cmd": 2,
      "clear_all_cmd": 1,
      "skip_cmd": 3,
      "slots": 100,
      "first_slot": 0,
      "display_offset": 0
    },
    "patch_structure": {
      "table_max_steps": 32
    }
  },
