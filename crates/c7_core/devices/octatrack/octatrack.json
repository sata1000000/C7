        "label": "Elektron Firmware",
        "url": "https://www.elektron.se/support-downloads/octatrack#resources",
        "official": true
      }
    ],
    "upload_instructions": [
      "Set the MIDI Inter-packet delay to 30 ms.",
      "Hold FUNCTION during power-on and select TRIG 3 (MIDI UPGRADE).",
      "Click 'Upload MIDI Upgrade File' below and pick the .syx file."
    ],
    "receive_instructions": [
      "Click 'Start Firmware Listener' below.",
      "Hold FUNCTION during power-on and select TRIG 4 (SEND UPGRADE)."
    ]
  },
  "sysex_header": [
    240,
    0,
    32,
    60,
    5
  ],
  "system": {
    "panic_all_notes_off": {
      "cc": 123,
      "val": 0,
      "description": "All Notes Off. The device claims CC 120-127 for its MIDI track solos, so this solos MIDI track 4."
    },
    "bank_select_reset": {
      "cc": 0,
      "val": 0,
      "description": "Sent alongside Panic to reset bank selects."
