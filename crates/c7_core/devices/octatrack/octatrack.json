  "note_mapping": {
    "default_mode": "standard",
    "note": "Six mutually exclusive maps for reading incoming notes, selected by the TRIG mode and MIDI MAP setting, or by AUDIO NOTE IN when it is not FOLLOW FW. An entry marked `per_track` walks the eight tracks upward from the note it lists, and `min`/`max` give the values the key span produces.",
    "modes": {
      "standard": {
        "fullname": "Standard",
        "note": "The factory default. Notes fire transport, recorders and track triggers rather than pitches.",
        "entries": [
          {"note": 24, "fullname": "Audio Track Play", "per_track": true, "stride": 1},
          {"note": 32, "fullname": "Unassigned", "kind": "unused"},
          {"note": 33, "fullname": "Sequencer Stop"},
          {"note": 34, "fullname": "Sequencer Start"},
          {"note": 35, "fullname": "Sequencer Restart"},
          {"note": 36, "fullname": "Audio Track Sample Trigger", "per_track": true, "stride": 1},
          {"note": 44, "fullname": "Unassigned", "size": 4, "kind": "unused"},
          {"note": 48, "fullname": "MIDI Track Play", "per_track": true, "stride": 1},
          {"note": 56, "fullname": "Unassigned", "size": 4, "kind": "unused"},
          {"note": 60, "fullname": "Combo Record"},
          {"note": 61, "fullname": "INAB Record"},
          {"note": 62, "fullname": "INCD Record"},
          {"note": 63, "fullname": "SRC3 Record"},
          {"note": 64, "fullname": "Pickup Play/Stop"},
          {"note": 65, "fullname": "Multiply"},
          {"note": 66, "fullname": "Mute Active Track"},
          {"note": 67, "fullname": "Cue Active Track"},
          {"note": 68, "fullname": "Active Track Up (Auto Channel Only)"},
          {"note": 69, "fullname": "Active Track Down (Auto Channel Only)"},
          {"note": 70, "fullname": "Toggle Sequencer Sync"},
          {"note": 71, "fullname": "Toggle Sequencer Sync And Start"},
          {"note": 72, "fullname": "Track Sample Pitch", "size": 25, "min": -12, "max": 12}
        ]
      },
      "chromatic": {
        "fullname": "Chromatic",
        "note": "Drives the track's SRC PTCH parameter across a two-octave span, one voice at a time. MIDI tracks ignore the limit and play the full 0-127 note range.",
        "entries": [
          {"note": 72, "fullname": "Track Sample Pitch", "size": 25, "min": -12, "max": 12}
        ]
      },
      "slots": {
        "fullname": "Slots",
        "note": "The first filled slot sounds on note 0 and the rest follow upward, so the usable range stops wherever the filled slots do.",
        "entries": [
          {"note": 0, "fullname": "Sample Slot", "size": 128, "min": 1, "max": 128}
        ]
      },
      "slices": {
        "fullname": "Slices",
        "note": "Plays the track sample's slices one per key, counting up from note 12. Silent unless that sample has actually been sliced.",
        "entries": [
          {"note": 12, "fullname": "Slice", "size": 64, "min": 1, "max": 64}
        ]
      },
      "quick_mute": {
        "fullname": "Quick Mute",
        "note": "Each key toggles one track's mute rather than triggering it.",
        "entries": [
          {"note": 12, "fullname": "Audio Track Mute Toggle", "per_track": true, "stride": 1},
          {"note": 20, "fullname": "MIDI Track Mute Toggle", "per_track": true, "stride": 1}
        ]
      },
      "delay_control": {
        "fullname": "Delay Control",
        "note": "Sets the delay TIME on a track using the Echo Freeze Delay effect. Takes two notes at once: hold the track-select key down, then send the time key. The two banks below are the same control offered with two different sets of time divisions.",
        "entries": [
          {"note": 12, "fullname": "Delay Time", "size": 8, "values_ref": "delay_time_binary"},
          {"note": 20, "fullname": "Delay Track Select", "per_track": true, "stride": 1},
          {"note": 36, "fullname": "Delay Time", "size": 8, "values_ref": "delay_time_triplet"},
          {"note": 44, "fullname": "Delay Track Select", "per_track": true, "stride": 1}
        ]
      }
    },
    "constants": {
      "delay_time_binary": [1, 2, 4, 8, 16, 32, 64, 128],
      "delay_time_triplet": [1, 3, 6, 12, 24, 48, 96, 128]
    }
  },
